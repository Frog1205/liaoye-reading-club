{
  "name": "liaoye-reading-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "check:repo": "node scripts/check-repository-safety.mjs --staged",
    "check:repo:history": "node scripts/check-repository-safety.mjs --history",
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node integrations/mcp-server.mjs",
    "build:cloud": "npm run build && node cloud/build.mjs",
    "deploy": "npm run build:cloud && wrangler pages deploy dist --project-name liaoye-reading --branch main"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.27.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "4.146.0"
  }
}
